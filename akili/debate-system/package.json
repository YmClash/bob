{
  "name": "tri-protocol-debate-system",
  "version": "1.0.0",
  "description": "Multi-Agent Debate System with Tri-Protocol SDK",
  "main": "dist/backend/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/backend/server.js",
    "dev": "ts-node-dev --respawn --transpile-only backend/server.ts",
    "dev:build": "tsc --watch",
    "frontend": "cd frontend && npm start",
    "install-all": "npm install && cd frontend && npm install",
    "clean": "rm -rf dist",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/uuid": "^9.0.7",
    "axios": "^1.12.2",
    "nodemon": "^3.0.2",
    "socket.io-client": "^4.8.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
